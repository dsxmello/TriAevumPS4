/out/
/pgo/
/sdk/
/src/
/sysroot/
/downloads/
/mesa-venv/
/refs/
/triaevum-src.git/
/docs/logs/
*.pkg
*.profraw
*.profdata
*.bin
*.elf
*.oelf
*.self
*.prx
*.sprx
*.spv
