+  bool Claim(uint64_t &sequence) {
+    uint64_t next = mNext.load(std::memory_order_relaxed);
+    for (;;) {
+      if (next >= mTail.load(std::memory_order_acquire)) {
+        return false;
+      }
+      if (mNext.compare_exchange_weak(next, next + 1, std::memory_order_acquire,
